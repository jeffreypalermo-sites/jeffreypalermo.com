#!/usr/bin/env bash
# A stand-in for the Azure CLI, for the tests that run deploy/deploy.ps1 and deploy/verify.ps1 (DeployScriptTests).
# It answers the few commands those scripts use from files in the folder $AZ_STUB_STATE, and logs every call there:
#   calls.log                    one line per call
#   environment-<name>           an express environment: line 1 its provisioning state, line 2 its mode
#   environment-<name>.unread    present after a create: the next read finds nothing yet, as Azure does
#   refused-locations            one location per line that refuses a new environment, as Azure does for a region
#                                the subscription may not use
#   stack-parameters.json        the parameters of the last "stack group create"
#   stack-fails                  when present, "stack group create" fails with this text
#   stack-fails-once             when present, "stack group create" fails with this text once: the file is removed,
#                                and the next attempt succeeds, as Azure did after "managed identity bootstrap failed"
#   deployment-errors            what a container app reports when asked why it did not start
#   stack-show.json              the answer to "stack group show"
#   dns-parameters.json, dns-show.json, dns-fails, dns-fails-once
#                                the same for a stack whose name ends in -dns: the DNS zone's own stack
#   purge-body.json              the request of the last purge ("resource invoke-action --action purge")
#   purge-fails, purge-fails-once   the same two for the purge
#   custom-domain-<name>.json    a custom domain of the Front Door as a read finds it (after a new token was asked for)
#   refresh-fails                when present, asking for a new validation token fails with this text
set -euo pipefail

state="${AZ_STUB_STATE:?AZ_STUB_STATE is the folder that holds what this stand-in knows}"
printf '%s\n' "$*" >> "$state/calls.log"

# The value that follows a flag.
value() {
  local flag="$1"
  shift
  while [ $# -gt 1 ]; do
    if [ "$1" = "$flag" ]; then
      printf '%s' "$2"
      return
    fi
    shift
  done
}

case "${1:-} ${2:-}" in
  "account show")
    echo "00000000-0000-0000-0000-000000000001"
    ;;
  "rest --method")
    method="$(value --method "$@")"
    url="$(value --url "$@")"
    path="${url%%\?*}"
    name="${path##*/}"
    case "$path" in
      */managedEnvironments/*)
        if [ "$method" = "put" ]; then
          body="$(value --body "$@")"
          location="$(sed --quiet 's/.*"location": *"\([^"]*\)".*/\1/p' "${body#@}" | head --lines=1)"
          if [ -f "$state/refused-locations" ] && grep --quiet --line-regexp "$location" "$state/refused-locations"; then
            echo "ERROR: Forbidden({\"error\":{\"code\":\"RequestDisallowedByAzure\",\"target\":\"$name\",\"message\":\"Resource '$name' was disallowed by Azure: The selected region is currently not accepting new customers: https://aka.ms/locationineligible.\"}})" >&2
            exit 1
          fi
          printf 'Succeeded\nExpress\n' > "$state/environment-$name"
          touch "$state/environment-$name.unread"
        elif [ "$method" = "delete" ]; then
          rm --force "$state/environment-$name" "$state/environment-$name.unread"
        elif [ -f "$state/environment-$name.unread" ]; then
          rm "$state/environment-$name.unread"
          echo "ERROR: (ResourceNotFound) $name was not found." >&2
          exit 3
        elif [ -f "$state/environment-$name" ]; then
          cat "$state/environment-$name"
        else
          echo "ERROR: (ResourceNotFound) $name was not found." >&2
          exit 3
        fi
        ;;
      */containerApps/*)
        if [ -f "$state/deployment-errors" ]; then cat "$state/deployment-errors"; fi
        ;;
      */customDomains/*)
        # A custom domain of the Front Door as it is now: after a new token was asked for, with the new token.
        if [ -f "$state/custom-domain-$name.json" ]; then
          cat "$state/custom-domain-$name.json"
        else
          echo "ERROR: (ResourceNotFound) $name was not found." >&2
          exit 3
        fi
        ;;
      *)
        echo "ERROR: the stand-in does not know $path" >&2
        exit 2
        ;;
    esac
    ;;
  "stack group")
    case "${3:-}" in
      create)
        # The site's stack, or the DNS zone's own (its name ends in -dns): each has its files.
        kind="stack"
        case "$(value --name "$@")" in *-dns) kind="dns" ;; esac
        parameters="$(value --parameters "$@")"
        cp "${parameters#@}" "$state/$kind-parameters.json"
        if [ -f "$state/$kind-fails-once" ]; then
          echo "ERROR: $(cat "$state/$kind-fails-once")" >&2
          rm "$state/$kind-fails-once"
          exit 1
        fi
        if [ -f "$state/$kind-fails" ]; then
          echo "ERROR: $(cat "$state/$kind-fails")" >&2
          exit 1
        fi
        echo "WARNING: a notice the Azure CLI writes on success" >&2
        ;;
      show)
        kind="stack"
        case "$(value --name "$@")" in *-dns) kind="dns" ;; esac
        cat "$state/$kind-show.json"
        ;;
      *)
        echo "ERROR: the stand-in does not know: $*" >&2
        exit 2
        ;;
    esac
    ;;
  "resource invoke-action")
    action="$(value --action "$@")"
    if [ "$action" = "refreshValidationToken" ]; then
      # A new validation token for a custom domain of the Front Door.
      if [ -f "$state/refresh-fails" ]; then
        echo "ERROR: $(cat "$state/refresh-fails")" >&2
        exit 1
      fi
      echo "WARNING: a notice the Azure CLI writes on success" >&2
      exit 0
    fi
    if [ "$action" != "purge" ]; then
      echo "ERROR: the stand-in does not know the action $action" >&2
      exit 2
    fi
    body="$(value --request-body "$@")"
    cp "${body#@}" "$state/purge-body.json"
    if [ -f "$state/purge-fails-once" ]; then
      echo "ERROR: $(cat "$state/purge-fails-once")" >&2
      rm "$state/purge-fails-once"
      exit 1
    fi
    if [ -f "$state/purge-fails" ]; then
      echo "ERROR: $(cat "$state/purge-fails")" >&2
      exit 1
    fi
    echo "WARNING: a notice the Azure CLI writes on success" >&2
    ;;
  *)
    echo "ERROR: the stand-in does not know: $*" >&2
    exit 2
    ;;
esac
